# Meta Graph API version
META_GRAPH_VERSION=v22.0

# Access token – use ONE of the following:
# A Page Access Token (scoped to a single page):
PAGE_ACCESS_TOKEN=your_page_access_token_here

# OR a User/System-User Access Token (can list all pages via /me/accounts):
# USER_ACCESS_TOKEN=your_user_access_token_here

# Optional: default page ID used when --scope page and no --page-id is given
# DEFAULT_PAGE_ID=123456789
